{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.AspNetCore.Diagnostics.ExceptionHandlerMiddleware": "None"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "DefaultConnection": "Host=localhost;Port=5433;Database=tickethub;Username=postgres;Password=postgres",
    "Redis": "localhost:6380"
  },
  "Jwt": {
    "Issuer": "TicketHub",
    "Audience": "TicketHub.Api",
    "SigningKey": "",
    "AccessTokenLifetimeMinutes": 60,
    "RefreshTokenLifetimeDays": 7
  },
  "RateLimiting": {
    "Window": "00:01:00",
    "AuthPermitLimit": 10,
    "BookingPermitLimit": 10
  },
  "BackgroundJobs": {
    "ExpiredHoldReaper": {
      "Interval": "00:00:15",
      "BatchSize": 100
    },
    "TicketFulfillment": {
      "SimulatedRenderDelay": "00:00:00.050",
      "SimulatedEmailDelay": "00:00:00.100"
    },
    "EventReminder": {
      "Interval": "01:00:00",
      "LeadTime": "1.00:00:00",
      "Window": "01:00:00",
      "BatchSize": 500
    }
  }
}
